{
  "framework": {
    "name": "ui5-webcomponents",
    "versions": ["1.24.0", "2.0.0"]
  },
  "application": {
    "path": "./my-ui5-app",
    "buildCommand": "npm run build",
    "startCommand": "npm start",
    "testCommand": "npm test",
    "port": 8080,
    "testPaths": ["src/**/*.test.ts", "src/**/*.spec.ts"],
    "sourcePaths": ["src/**/*.tsx", "src/**/*.ts"]
  },
  "components": {
    "exclude": ["ui5-shellbar"]
  },
  "containers": {
    "runtime": "docker",
    "baseImage": "node:18-alpine",
    "resources": {
      "memory": "4g",
      "cpu": 4
    }
  },
  "testing": {
    "browsers": ["chromium"],
    "viewport": {
      "width": 1920,
      "height": 1080
    },
    "timeout": 60000,
    "retries": 3,
    "headless": true
  },
  "analysis": {
    "visualThreshold": 0.1,
    "domIgnoreAttributes": ["data-testid", "data-qa"],
    "performanceThresholds": {
      "fcp": 1800,
      "lcp": 2500,
      "tti": 3800
    }
  },
  "ai": {
    "provider": "anthropic",
    "model": "claude-sonnet-4-5-20250929",
    "temperature": 0.5,
    "maxTokens": 8192
  },
  "storage": {
    "type": "local",
    "path": "./data"
  },
  "reporting": {
    "format": ["markdown", "html", "json"],
    "outputPath": "./reports"
  },
  "upgrade": {
    "updatePeerDependencies": true,
    "resolveConflicts": "auto",
    "fixTests": true,
    "testTimeout": 300000,
    "incremental": false,
    "createBranches": true
  }
}
