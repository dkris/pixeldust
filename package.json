{
  "name": "@pixeldust/ui-version-tester",
  "version": "0.2.0",
  "description": "Agentic AI system for automated UI version testing and remediation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pixeldust": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "cli": "node dist/cli/index.js",
    "prepare": "npm run build",
    "postinstall": "playwright install chromium --with-deps || echo 'Note: Playwright browser installation failed. Run: npx playwright install'"
  },
  "keywords": [
    "ui-testing",
    "visual-regression",
    "ai-agent",
    "playwright",
    "version-testing",
    "ui5-webcomponents",
    "autonomous-testing"
  ],
  "author": "PixelDust Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@modelcontextprotocol/sdk": "^0.5.1",
    "@playwright/test": "^1.40.0",
    "better-sqlite3": "^9.2.2",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "cosmiconfig": "^9.0.0",
    "diff-dom": "^5.1.3",
    "dockerode": "^4.0.2",
    "express": "^4.18.2",
    "handlebars": "^4.7.8",
    "js-beautify": "^1.14.11",
    "jsdom": "^23.0.1",
    "marked": "^11.1.1",
    "open": "^10.0.3",
    "openai": "^4.20.1",
    "ora": "^8.0.1",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "resemblejs": "^4.1.0",
    "simple-git": "^3.21.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.23",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/js-beautify": "^1.14.3",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.10.6",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
